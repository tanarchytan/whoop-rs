# Rust build artifacts
/target

# Local working notes — provenance + per-crate clean confirm, not shipped
/dev-docs/

# Decoded history dumps + live BLE captures (real personal HR/timestamps) — never commit
*.jsonl
*.log
mon-*.txt

# Python bytecode from the tools/ gates
__pycache__/

# Editor / OS
*.swp
.DS_Store

# Calibration store (per-strap personal data) — never commit
*.db

# Test fixtures — tracked or ignored by decision, never by accident.
# TRACKED: everything else under crates/*/tests/fixtures/. It is derived only from openly licensed
# corpora (AAUWSS CC-BY-4.0, PhysioNet afdb/nsrdb/mitdb ODC-BY 1.0); both licences allow
# redistribution with attribution, which the fixture headers carry. See that dir's README.
# IGNORED: anything reproducing a RESTRICTED corpus. DREAMT is PhysioNet credentialed-access, so no
# DREAMT-derived fixture may be committed at any size — it is regenerated locally from the download.
/crates/*/tests/fixtures/restricted/
/crates/*/tests/fixtures/dreamt*/

# Left by dev-notes/mutate_*.py while they rewrite source in place. Its presence means DO NOT COMMIT.
.mutation-in-progress
